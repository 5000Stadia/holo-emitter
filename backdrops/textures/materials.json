  "aliases": [
    {
      "from": "ceiling/boarded-oak-joists",
      "to": "ceiling/plain-exposed-joists",
      "slot": "ceiling",
      "reason": "the same ceiling said twice -- plain oak boards on exposed joists."
    },
    {
      "from": "ceiling/flat-lime-plaster",
      "to": "ceiling/plain-lime-plaster",
      "slot": "ceiling",
      "reason": "plain and flat are synonyms here; the material is lime plaster either way."
    },
    {
      "from": "ceiling/plain-plastered-soffit",
      "to": "ceiling/plain-lime-plaster",
      "slot": "ceiling",
      "reason": "a soffit is where the plaster is, not what it is; plain plaster and plain lime plaster are one material in this period."
    },
    {
      "from": "floor/broad-stone-flags",
      "to": "floor/worn-stone-flags",
      "slot": "floor",
      "reason": "broad/large/worn are size adjectives on one material. NO voice's period justification names a different stone or a different laying pattern -- checked, all three say worn stone flags."
    },
    {
      "from": "floor/gallery-long-oak-boards",
      "to": "floor/wide-oak-boards",
      "slot": "floor",
      "reason": "\"running the length of the gallery\" is a LAYING DIRECTION, and direction is already carried by grain_axis room_long, which all three share -- so it is not a second material."
    },
    {
      "from": "floor/large-worn-stone-flags",
      "to": "floor/worn-stone-flags",
      "slot": "floor",
      "reason": "as above: a size adjective, not a different stone."
    },
    {
      "from": "floor/scrubbed-oak-treads-boards",
      "to": "floor/broad-oak-treads-boards",
      "slot": "floor",
      "reason": "broad and plain scrubbed are finish adjectives on oak treads and boards. Kept separate from the floorboards: treads name a stair surface."
    },
    {
      "from": "floor/wide-worn-oak-boards",
      "to": "floor/wide-oak-boards",
      "slot": "floor",
      "reason": "worn is a finish adjective on wide oak floorboards."
    },
    {
      "from": "wall/plain-oak-wainscot-limewash",
      "to": "wall/oak-wainscot-limewash",
      "slot": "walls",
      "reason": "differ only by \"plain\" and \"to chair height\" -- both are oak wainscot below limewashed plaster. THE CONSEQUENCE IS THE POINT: cross_passage had no promoted facing and was the library's only wall swatch; great_stair has one, so this alias turns an ask into a harvest."
    },
    {
      "from": "wall/rough-limewash-over-stone",
      "to": "wall/plain-limewash-to-floor",
      "slot": "walls",
      "reason": "\"rough ... over stone\" and \"plain\" are finish adjectives over the same material: limewashed plaster carried straight to the floor with no joinery."
    }
  ],
