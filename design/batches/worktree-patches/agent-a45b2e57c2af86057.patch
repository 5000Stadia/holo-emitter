+ *
+ *   THE DECODER. A misread PNG changes every number this instrument produces
+ *     and nothing downstream would notice, so it is checked against a decoder
+ *     nobody here wrote — the browser's own, over the same file.
+ *   THE WITHHOLDING. A body too small to read must be a refusal to speak and
+ *     not a "no", because "no" costs a re-ask of art that may be right.
+ */
+test.describe("the flight a painting has or has not", () => {
+  const FRAME = join(repoRoot, "backdrops", "study", "N.png");
+
+  test("the reader agrees with the browser's own decoder", async ({ page }) => {
+    const mine = readLumaPng(readFileSync(FRAME));
+    expect([mine.w, mine.h], "the frame this project paints").toEqual([1536, 1024]);
+    await page.goto(navUrl());
+    const b64 = readFileSync(FRAME).toString("base64");
+    /* A GRID OF POINTS RATHER THAN A CHECKSUM, so a failure says where the two
+       decoders part company. Every 97th column and 89th row — coprime with the
+       frame, so the sample walks the whole picture instead of one band. */
+    const theirs = await page.evaluate(async (data) => {
+      const bin = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));
+      const bmp = await createImageBitmap(new Blob([bin], { type: "image/png" }));
+      const cv = new OffscreenCanvas(bmp.width, bmp.height);
+      const ctx = cv.getContext("2d", { willReadFrequently: true });
+      ctx.drawImage(bmp, 0, 0);
+      const px = ctx.getImageData(0, 0, bmp.width, bmp.height).data;
+      const out = [];
+      for (let y = 0; y < bmp.height; y += 89) {
+        for (let x = 0; x < bmp.width; x += 97) {
+          const o = (y * bmp.width + x) * 4;
+          out.push([x, y, 0.2126 * px[o] + 0.7152 * px[o + 1] + 0.0722 * px[o + 2]]);
+        }
+      }
+      return out;
+    }, b64);
+    expect(theirs.length, "the sample actually walked the frame").toBeGreaterThan(150);
+    let worst = 0, at = null;
+    for (const [x, y, v] of theirs) {
+      const d = Math.abs(mine.L[y * mine.w + x] - v);
+      if (d > worst) { worst = d; at = [x, y]; }
