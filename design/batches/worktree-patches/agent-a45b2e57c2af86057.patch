+       its projected body is under 2 % of the picture. A verdict from that is a
+       verdict from noise, so there is none — and the promotion attaches, the
+       same way a WITHHELD measurement everywhere else in this project is a
+       refusal to speak rather than a finding. */
+    const meta = deriveMeta(PLAN, "back_stair_head", "W");
+    const flight = (meta.stairs || [])[0];
+    expect(flight, "back_stair_head/W draws a flight").toBeTruthy();
+    const picture = readLumaPng(readFileSync(FRAME));
+    const r = flightReading(picture, flight);
+    expect(r.body_px, "and it is under the floor this reading answers above")
+      .toBeLessThan(MIN_READABLE_BODY_PX);
