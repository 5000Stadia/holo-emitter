+    const a = flightReading(picture, flight);
+    const b = flightReading(readLumaPng(readFileSync(FRAME)), flight);
+    expect(a).toEqual(b);
+    expect(a.readable, "and this one is big enough to have an answer").toBe(true);
+  });
+
+  test("the ask's own mark is what the promotion looks for", () => {
+    /* One rule read in two directions: the sentence the emitter writes must
