+def _crossing(patch):
+    """Fine-edge energy where BOTH axes have an edge at once.
+
+    A came grid crosses itself; a run of boards, a shelf edge or a chair rail
+    does not. So what is summed is `min(|dx|, |dy|)` rather than either gradient
+    on its own — a horizontal moulding scores nothing here however strong it is.
+    """
+    if patch.shape[0] < 8 or patch.shape[1] < 8:
+        return 0.0
+    gx = np.abs(patch[:, 2:] - patch[:, :-2])
+    gy = np.abs(patch[2:, :] - patch[:-2, :])
+    h = min(gx.shape[0] - 2, gy.shape[0])
+    w = min(gx.shape[1], gy.shape[1] - 2)
+    if h < 1 or w < 1:
+        return 0.0
+    return float(np.minimum(gx[2:2 + h, :w], gy[:h, 2:2 + w]).mean())
+
+
+def _inset(x0, x1, y0, y1, f=0.12):
+    """The light's INSIDE, with its surround and reveals left out.
+
+    A stone surround is the brightest edge on the wall and its reveals are the
+    darkest, so a rectangle read to its own stable edges carries both — and the
+    leading's depth, which is a statistic about what is INSIDE the glass, would
+    read the surround's shadow as came. The inset is small enough to keep the
+    outermost quarries and large enough to drop the frame.
+    """
+    ix = int(round(f * (x1 - x0)))
+    iy = int(round(f * (y1 - y0)))
+    if x1 - x0 - 2 * ix < 12 or y1 - y0 - 2 * iy < 12:
+        return x0, x1, y0, y1
+    return x0 + ix, x1 - ix, y0 + iy, y1 - iy
+
+
+def leading(L, x0, x1, y0, y1, wall_crossing):
+    """How much of this light's own brightness the dark structure in it takes.
+
+    THE PRIMARY TEST, and a ratio inside one rectangle on purpose: `depth` is
+    `(p90 - p10) / p90`, so it says "the glass here is crossed by lines that are
+    60 % darker than the glass" without ever consulting the wall, the painter's
+    key or row 37's lighting pass. Leaded glass scores 0.60-0.96 on this store
+    and flat bright plaster 0.11-0.47.
+
+    `crossing` is the same rectangle's both-axis fine-edge energy against the
+    WALL's own plaster texture, and it is the depth's other half: the depth says
+    something dark lies over the glass and the crossing says it runs both ways.
+    A window runs 2.3-24 times its wall's texture and a bright piece of wall
+    0.8-4.9, so it does not hold the discrimination on its own — its floor is
+    set below every painted window in the corpus and refuses only structure that
